PORT=3000
BASE_URL=http://localhost:3000
DB_URL=mongodb://127.0.0.1:27017/blog_api
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# SMTP (optional in development: if EMAIL_HOST is empty the verification link is printed in the console)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Blog API <no-reply@example.com>"

# Set to 1 when running behind a reverse proxy (so rate limiting sees the real client IP)
TRUST_PROXY=
